# PDF Ingestion AI Agent - Environment Variables Configuration
# Copy this file to .env and fill in your actual values

# ===== LLM Configuration =====
# LLM API URL - URL for the LLM service
API_URL=

# LLM API Key - Required for LLM vision analysis and enhanced processing
LLM_API_KEY=

# LiteLLM Model - Model to use for LLM processing
LLM_MODEL=

# ===== PDF Processing Configuration =====
# Maximum number of PDFs to process in parallel (default: 5)
MAX_PARALLEL_PDFS=5

# ===== Logging Configuration =====
# Log level for the application (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
